model CharacterLocationReference {
  locationId  String            @map("location_id") @db.Uuid
  mediaId     String            @map("media_id") @db.Uuid
  sortOrder   Int               @default(0) @map("sort_order")
  description String            @default("")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  location    CharacterLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  media       Media             @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([locationId, mediaId])
  @@index([locationId, sortOrder])
  @@map("character_location_references")
  @@schema("opod")
}

model CharacterActionLog {
  id          BigInt    @id @default(autoincrement())
  characterId String    @map("character_id") @db.Uuid
  actionType  String    @map("action_type")
  targetTable String?   @map("target_table")
  targetId    String?   @map("target_id") @db.Uuid
  reason      String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  character   Character @relation(fields: [characterId], references: [id])

  @@index([characterId, createdAt])
  @@map("character_action_logs")
  @@schema("opod")
}

model Report {
  id             String           @id @default(uuid(7)) @db.Uuid
  reporterUserId String           @map("reporter_user_id") @db.Uuid
  targetType     ReportTargetType @map("target_type")
  targetId       String           @map("target_id") @db.Uuid
  reason         String
  details        String?
  resolution     String?
  status         ReportStatus     @default(submitted)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
