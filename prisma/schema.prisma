generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["opod"]
}

enum MediaType {
  image
  video

  @@map("media_type")
  @@schema("opod")
}

enum PostContentType {
  feed
  reel

  @@map("post_content_type")
  @@schema("opod")
}

enum MessageSenderType {
  user
  character

  @@map("message_sender_type")
  @@schema("opod")
}

enum CreditLedgerType {
  grant
  usage
  refund_recovery
  adjustment

  @@map("credit_ledger_type")
  @@schema("opod")
}

enum CreditKind {
  free
  paid

  @@map("credit_kind")
  @@schema("opod")
}

enum CreditPurchaseStatus {
  pending
  payment_processing
  completed
  failed
  canceled
  refunded
  reversed

  @@map("credit_purchase_status")
  @@schema("opod")
}

enum CreditReservationStatus {
  reserved
  captured
  released

  @@map("credit_reservation_status")
  @@schema("opod")
}

enum CreditRefundStatus {
  reserved
  payment_processing
  payment_succeeded
  completed
  failed
  canceled

  @@map("credit_refund_state")
  @@schema("opod")
}

enum PaymentChannel {
  web
  apple
  google

  @@map("payment_channel")
  @@schema("opod")
}

enum PaymentStatus {
  pending
  verified
  processing
  paid
  failed
  canceled
  partially_refunded
  refunded
  reversed

  @@map("payment_status")
  @@schema("opod")
}

enum PaymentLedgerType {
  capture
  refund
  chargeback
  adjustment

  @@map("payment_ledger_type")
  @@schema("opod")
}

enum PaymentDirection {
  inflow
  outflow

  @@map("payment_direction")
  @@schema("opod")
}

enum PaymentProviderEventStatus {
  processing
  processed
  failed

  @@map("payment_provider_event_status")
  @@schema("opod")
}

enum GenerationJobStatus {
  draft
  queued
  running
  completed
  failed

  @@map("generation_job_status")
  @@schema("opod")
}

// docs/media-generation-pipeline.md 상태 머신. needs_review = arch doc의 review.
enum PostDraftStatus {
  planned
  generating
  needs_review
  regenerating
  approved
  rejected
  published
  failed

  @@map("post_draft_status")
  @@schema("opod")
}

enum PostDraftType {
  post
  story

  @@map("post_draft_type")
  @@schema("opod")
}

enum ReportTargetType {
  character
  post
  message

  @@map("report_target_type")
  @@schema("opod")
}

enum ReportStatus {
  submitted
  reviewing
  resolved
  rejected

  @@map("report_status")
  @@schema("opod")
}

enum CharacterStatus {
  active
  inactive

  @@map("character_status")
  @@schema("opod")
}

enum InquiryStatus {
  submitted
  answered

  @@map("inquiry_status")
  @@schema("opod")
}

enum ConsentType {
  terms_of_service
  privacy
  age_14
  marketing

  @@map("consent_type")
  @@schema("opod")
}

model User {
  id                   String                  @id @default(uuid(7)) @db.Uuid
  email                String?                 @unique
  passwordHash         String?                 @map("password_hash")
  passwordSalt         String?                 @map("password_salt")
  displayName          String                  @map("display_name")
  bio                  String                  @default("")
  profileImageUrl      String?                 @map("profile_image_url")
  adultVerifiedAt      DateTime?               @map("adult_verified_at") @db.Timestamptz(6)
  adultIdentityHash    String?                 @unique @map("adult_identity_hash")
  debtIdentityHash     String?                 @unique @map("debt_identity_hash")
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?               @map("deleted_at") @db.Timestamptz(6)
  characterFollows     UserCharacterFollow[]
  consents             UserConsent[]
  creditCheckIns       CreditCheckIn[]
  creditLedger         CreditLedger[]
  creditPurchases      CreditPurchase[]
  creditReservations   CreditReservation[]
  events               UserEvent[]
  inquiries            Inquiry[]
  messageConversations MessageConversation[]
  notifications        Notification[]
  postComments         PostComment[]
  postReactions        PostReaction[]
  refreshTokens        UserRefreshToken[]
  reports              Report[]
  hashtagPreferences   UserHashtagPreference[]
  userAccounts         UserAccount[]

  @@map("users")
  @@schema("opod")
}

model UserAccount {
  id                String   @id @default(uuid(7)) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String
  providerAccountId String   @map("provider_account_id")
  email             String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("user_accounts")
  @@schema("opod")
}

model UserRefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_refresh_tokens")
  @@schema("opod")
}

model UserWithdrawal {
  id             String   @id @default(uuid(7)) @db.Uuid
  // 익명화된 users 행을 느슨하게 가리키는 평문 uuid (FK 없음).
  userId         String   @map("user_id") @db.Uuid
  reasonCategory String?  @map("reason_category")
  reasonText     String?  @map("reason_text")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("user_withdrawals")
  @@schema("opod")
}

// 약관·개인정보 처리방침 문서. 유형별로 effectiveAt이 지난 것 중 가장 최근
// 시행분이 현재 버전이다. 작성·발행은 opod-admin이 담당한다.
model TermsDocument {
  id          String      @id @default(uuid(7)) @db.Uuid
  type        ConsentType
  version     String
  title       String
  body        String
  effectiveAt DateTime    @map("effective_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([type, version])
  @@index([type, effectiveAt])
  @@map("terms_documents")
  @@schema("opod")
}

// 동의 증빙 기록. append-only이며 유형별 최신 행이 현재 동의 상태다.
// 탈퇴 후에도 익명화된 users 행에 연결을 유지한다 (증빙 보존).
model UserConsent {
  id        String      @id @default(uuid(7)) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  type      ConsentType
  version   String
  agreed    Boolean
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User        @relation(fields: [userId], references: [id])

  @@index([userId, type, createdAt])
  @@map("user_consents")
  @@schema("opod")
}

model UnsettledCreditDebt {
  identityHash String   @id @map("identity_hash")
  paidDebt     Int      @map("paid_debt")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("unsettled_credit_debts")
  @@schema("opod")
}

model Faq {
  id          String   @id @default(uuid(7)) @db.Uuid
  category    String
  question    String
  answer      String
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isPublished, category, sortOrder])
  @@map("faqs")
  @@schema("opod")
}

model Notice {
  id          String    @id @default(uuid(7)) @db.Uuid
  title       String
  body        String
  isPinned    Boolean   @default(false) @map("is_pinned")
  // null = 초안, 미래 시각 = 예약 발행. 발행분만 서비스에 노출된다.
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isPinned, publishedAt])
  @@map("notices")
  @@schema("opod")
}

model Inquiry {
  id         String        @id @default(uuid(7)) @db.Uuid
  // 탈퇴 후에도 익명화된 users 행에 연결을 유지한다 (분쟁처리 기록 보존).
  userId     String        @map("user_id") @db.Uuid
  category   String
  body       String
  status     InquiryStatus @default(submitted)
  // 답변은 opod-admin이 기록한다. 답변 저장 시 inquiry.answered 알림 계약 참조.
  answerBody String?       @map("answer_body")
  answeredAt DateTime?     @map("answered_at") @db.Timestamptz(6)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       User          @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("inquiries")
  @@schema("opod")
}

// 운영 콘솔에서 관리하는 키-값 설정 (예: 생성 프로바이더 API 키/모델).
// 쓰기는 opod-admin만 수행한다. 값은 평문 저장이므로 노출 API는 반드시 마스킹한다.
model AdminSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("admin_settings")
  @@schema("opod")
}

model Admin {
  id            String          @id @default(uuid(7)) @db.Uuid
  email         String          @unique
  password      String
  isEnabled     Boolean         @default(true) @map("is_enabled")
  isDeleted     Boolean         @default(false) @map("is_deleted")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  paymentLedger PaymentLedger[]

  @@index([isEnabled, isDeleted])
  @@map("admins")
  @@schema("opod")
}

model Character {
  id                   String                  @id @default(uuid(7)) @db.Uuid
  publicId             String                  @unique @map("public_id")
  displayName          String                  @map("display_name")
  bio                  String
  interests            String[]                @default([])
  status               CharacterStatus         @default(active)
  profileImageId       String?                 @map("profile_image_id") @db.Uuid
  profileImageCropX    Float                   @default(0.5) @map("profile_image_crop_x")
  profileImageCropY    Float                   @default(0.5) @map("profile_image_crop_y")
  profileImageCropZoom Float                   @default(1) @map("profile_image_crop_zoom")
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  actionLogs           CharacterActionLog[]
  comments             PostComment[]
  conversations        MessageConversation[]
  generationJobs       GenerationJob[]
  memories             CharacterMemory[]
  personas             CharacterPersona[]
  posts                Post[]
  reactions            PostReaction[]
  stories              Story[]
  userFollowers        UserCharacterFollow[]
  visualProfile        CharacterVisualProfile?
  locations            CharacterLocation[]
  postDrafts           PostDraft[]
  postingPolicy        CharacterPostingPolicy?
  profileImage         Media?                  @relation("CharacterProfileImage", fields: [profileImageId], references: [id], onDelete: SetNull)

  @@index([profileImageId])
  @@map("characters")
  @@schema("opod")
}

model UserCharacterFollow {
  userId      String    @map("user_id") @db.Uuid
  characterId String    @map("character_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  // 팔로우 알림 워터마크. 이 시각 이후 게시글·스토리만 알림 대상이다.
  // 기본값이 팔로우 시각이라 팔로우 이전 콘텐츠는 알림되지 않는다.
  notifiedUpToAt DateTime @default(now()) @map("notified_up_to_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id])
  character   Character @relation(fields: [characterId], references: [id])

  @@id([userId, characterId])
  @@map("user_character_follows")
  @@schema("opod")
}

model Media {
  id                      String                            @id @default(uuid(7)) @db.Uuid
  mediaType               MediaType                         @map("media_type")
  url                     String
  storageKey              String?                           @unique @map("storage_key")
  contentType             String?                           @map("content_type")
  byteSize                Int?                              @map("byte_size")
  width                   Int?
  height                  Int?
  durationSeconds         Int?                              @map("duration_seconds")
  // AI 기본법 합성콘텐츠 표시 의무 근거 플래그. 워커가 생성한 미디어는 항상 true.
  isAiGenerated           Boolean                           @default(false) @map("is_ai_generated")
  uploadedAt              DateTime?                         @map("uploaded_at") @db.Timestamptz(6)
  createdAt               DateTime                          @default(now()) @map("created_at") @db.Timestamptz(6)
  generationJobs          GenerationJob[]
  jobOutputs              GenerationJobOutput[]
  llmLogMedia             LlmLogMedia[]
  postMedia               PostMedia[]
  characterProfileImages  Character[]                       @relation("CharacterProfileImage")
  stories                 Story[]
  visualProfileReferences CharacterVisualProfileReference[]
  locationReferences      CharacterLocationReference[]

  @@map("media")
  @@schema("opod")
}

model Post {
  id           String          @id @default(uuid(7)) @db.Uuid
  characterId  String          @map("character_id") @db.Uuid
  character    Character       @relation(fields: [characterId], references: [id])
  contentType  PostContentType @default(feed) @map("content_type")
  content      String          @default("")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  comments     PostComment[]
  hashtags     PostHashtag[]
  postMedia    PostMedia[]
  reactions    PostReaction[]
  sourceDrafts PostDraft[]

  @@map("posts")
  @@schema("opod")
}

model Hashtag {
  id          String                  @id @default(uuid(7)) @db.Uuid
  name        String                  @unique
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  posts       PostHashtag[]
  preferences UserHashtagPreference[]

  @@map("hashtags")
  @@schema("opod")
}

model PostHashtag {
  postId    String  @map("post_id") @db.Uuid
  hashtagId String  @map("hashtag_id") @db.Uuid
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([postId, hashtagId])
  @@index([hashtagId])
  @@map("post_hashtags")
  @@schema("opod")
}

model PostMedia {
  postId    String @map("post_id") @db.Uuid
  mediaId   String @map("media_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")
  post      Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  media     Media  @relation(fields: [mediaId], references: [id])

  @@id([postId, mediaId])
  @@map("post_media")
  @@schema("opod")
}

model Story {
  id           String      @id @default(uuid(7)) @db.Uuid
  characterId  String      @map("character_id") @db.Uuid
  mediaId      String      @map("media_id") @db.Uuid
  caption      String      @default("")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime    @map("expires_at") @db.Timestamptz(6)
  character    Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  media        Media       @relation(fields: [mediaId], references: [id])
  sourceDrafts PostDraft[]

  @@index([expiresAt, createdAt])
  @@index([characterId, expiresAt, createdAt])
  @@map("stories")
  @@schema("opod")
}

model PostComment {
  id          String     @id @default(uuid(7)) @db.Uuid
  postId      String     @map("post_id") @db.Uuid
  characterId String?    @map("character_id") @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  body        String
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  post        Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  character   Character? @relation(fields: [characterId], references: [id])
  user        User?      @relation(fields: [userId], references: [id])

  @@index([postId, createdAt])
  @@index([characterId, createdAt])
  @@index([userId, createdAt])
  @@map("post_comments")
  @@schema("opod")
}

model PostReaction {
  id           String     @id @default(uuid(7)) @db.Uuid
  postId       String     @map("post_id") @db.Uuid
  characterId  String?    @map("character_id") @db.Uuid
  userId       String?    @map("user_id") @db.Uuid
  reactionType String     @map("reaction_type")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  post         Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  character    Character? @relation(fields: [characterId], references: [id])
  user         User?      @relation(fields: [userId], references: [id])

  @@unique([postId, userId, reactionType])
  @@index([postId, createdAt])
  @@index([characterId, createdAt])
  @@index([userId, createdAt])
  @@map("post_reactions")
  @@schema("opod")
}

model UserEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  eventType  String   @map("event_type")
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([targetType, targetId])
  @@map("user_events")
  @@schema("opod")
}

model UserHashtagPreference {
  userId    String   @map("user_id") @db.Uuid
  hashtagId String   @map("hashtag_id") @db.Uuid
  score     Float    @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  hashtag   Hashtag  @relation(fields: [hashtagId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@id([userId, hashtagId])
  @@index([hashtagId])
  @@map("user_hashtag_preferences")
  @@schema("opod")
}

model Notification {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String
  title      String
  body       String?
  targetType String?   @map("target_type")
  targetId   String?   @map("target_id") @db.Uuid
  readAt     DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
  @@schema("opod")
}

model MessageConversation {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  characterId String    @map("character_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  // 유저가 이 대화를 마지막으로 읽은 시각. null이면 한 번도 읽지 않았다는 뜻이라
  // 캐릭터 메시지 전부가 미읽음이다. 앱이 대화를 실제로 보여줄 때 갱신한다.
  lastReadAt  DateTime? @map("last_read_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id])
  character   Character @relation(fields: [characterId], references: [id])
  messages    Message[]

  @@unique([userId, characterId])
  @@map("message_conversations")
  @@schema("opod")
}

model Message {
  id             String              @id @default(uuid(7)) @db.Uuid
  conversationId String              @map("conversation_id") @db.Uuid
  senderType     MessageSenderType   @map("sender_type")
  body           String
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   MessageConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
  @@schema("opod")
}

model CreditLedger {
  id                String           @id @default(uuid(7)) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  type              CreditLedgerType
  creditKind        CreditKind?      @map("credit_kind")
  purchaseId        String?          @map("purchase_id") @db.Uuid
  promotionCode     String?          @map("promotion_code")
  amount            Int
  expiresAt         DateTime?        @map("expires_at") @db.Timestamptz(6)
  reason            String
  externalReference String?          @unique @map("external_reference")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user              User             @relation(fields: [userId], references: [id])
  purchase          CreditPurchase?  @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  usage             CreditUsage[]    @relation("UsageLedger")
  usageSources      CreditUsage[]    @relation("UsageGrant")

  @@index([userId, createdAt])
  @@index([userId, type, creditKind, expiresAt])
  @@index([purchaseId])
  @@map("credit_ledger")
  @@schema("opod")
}

model CreditProduct {
  id           String                  @id @default(uuid(7)) @db.Uuid
  code         String                  @unique
  name         String
  creditAmount Int                     @map("credit_amount")
  isActive     Boolean                 @default(true) @map("is_active")
  displayOrder Int                     @default(0) @map("display_order")
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  mappings     PaymentProductMapping[]
  purchases    CreditPurchase[]

  @@index([isActive, displayOrder])
  @@map("credit_products")
  @@schema("opod")
}

model PaymentProductMapping {
  id                String         @id @default(uuid(7)) @db.Uuid
  creditProductId   String         @map("credit_product_id") @db.Uuid
  channel           PaymentChannel
  provider          String
  environment       String
  providerProductId String         @map("provider_product_id")
  priceAmount       Int?           @map("price_amount")
  currency          String?
  isActive          Boolean        @default(true) @map("is_active")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  creditProduct     CreditProduct  @relation(fields: [creditProductId], references: [id], onDelete: Restrict)

  @@unique([creditProductId, channel, provider, environment])
  @@unique([provider, environment, providerProductId])
  @@index([channel, provider, environment, isActive])
  @@map("payment_product_mappings")
  @@schema("opod")
}

model CreditPurchase {
  id             String               @id @default(uuid(7)) @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  creditProductId String               @map("credit_product_id") @db.Uuid
  productId      String               @map("product_id")
  status         CreditPurchaseStatus @default(pending)
  creditAmount   Int                  @map("credit_amount")
  idempotencyKey String               @map("idempotency_key")
  fulfilledAt    DateTime?            @map("fulfilled_at") @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User                 @relation(fields: [userId], references: [id])
  creditProduct  CreditProduct        @relation(fields: [creditProductId], references: [id], onDelete: Restrict)
  payment        Payment?
  ledger         CreditLedger[]
  refunds        CreditRefund[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([creditProductId, createdAt])
  @@index([status, createdAt])
  @@map("credit_purchases")
  @@schema("opod")
}

model Payment {
  id                     String                 @id @default(uuid(7)) @db.Uuid
  purchaseId             String                 @unique @map("purchase_id") @db.Uuid
  channel                PaymentChannel
  provider               String
  status                 PaymentStatus          @default(pending)
  amount                 Int?
  currency               String?
  providerCheckoutId     String?                @map("provider_checkout_id")
  providerCheckoutUrl    String?                @map("provider_checkout_url")
  providerTransactionId  String?                @map("provider_transaction_id")
  providerTransactionKey String?                @map("provider_transaction_key")
  providerProductId      String                 @map("provider_product_id")
  providerEnvironment    String?                @map("provider_environment")
  paidAt                 DateTime?              @map("paid_at") @db.Timestamptz(6)
  refundedAt             DateTime?              @map("refunded_at") @db.Timestamptz(6)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  purchase               CreditPurchase         @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  ledger                 PaymentLedger[]
  providerEvents         PaymentProviderEvent[]

  @@unique([provider, providerCheckoutId])
  @@unique([provider, providerTransactionKey])
  @@index([provider, providerTransactionId])
  @@index([provider, status, createdAt])
  @@index([status, updatedAt])
  @@map("payments")
  @@schema("opod")
}

model PaymentLedger {
  id                    String            @id @default(uuid(7)) @db.Uuid
  paymentId             String            @map("payment_id") @db.Uuid
  type                  PaymentLedgerType
  direction             PaymentDirection
  amount                Int?
  currency              String?
  providerTransactionId String?           @map("provider_transaction_id")
  providerEventId       String?           @map("provider_event_id")
  adminId               String?           @map("admin_id") @db.Uuid
  reason                String?
  details               Json?
  occurredAt            DateTime          @map("occurred_at") @db.Timestamptz(6)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  payment               Payment           @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  admin                 Admin?            @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([paymentId, occurredAt])
  @@index([type, occurredAt])
  @@index([providerTransactionId])
  @@index([adminId, occurredAt])
  @@map("payment_ledger")
  @@schema("opod")
}

model PaymentProviderEvent {
  id              String                     @id @default(uuid(7)) @db.Uuid
  paymentId       String?                    @map("payment_id") @db.Uuid
  provider        String
  externalEventId String                     @map("external_event_id")
  eventType       String                     @map("event_type")
  status          PaymentProviderEventStatus @default(processing)
  attempts        Int                        @default(1)
  lastErrorCode   String?                    @map("last_error_code")
  processedAt     DateTime?                  @map("processed_at") @db.Timestamptz(6)
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  payment         Payment?                   @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEventId])
  @@index([status, updatedAt])
  @@map("payment_provider_events")
  @@schema("opod")
}

model CreditRefund {
  id                    String             @id @default(uuid(7)) @db.Uuid
  purchaseId            String             @map("purchase_id") @db.Uuid
  status                CreditRefundStatus @default(reserved)
  reason                String             @default("user_request")
  provider              String
  idempotencyKey        String             @map("idempotency_key")
  creditAmount          Int                @map("credit_amount")
  promotionAmount       Int                @default(0) @map("promotion_amount")
  lockedAmount          Int                @map("locked_amount")
  recoveryAmount        Int                @map("recovery_amount")
  debtAmount            Int                @default(0) @map("debt_amount")
  grossAmount           Int                @map("gross_amount")
  feeAmount             Int                @map("fee_amount")
  refundAmount          Int                @map("refund_amount")
  currency              String
  providerRefundId      String?            @map("provider_refund_id")
  providerTransactionId String?            @map("provider_transaction_id")
  completedAt           DateTime?          @map("completed_at") @db.Timestamptz(6)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  purchase              CreditPurchase     @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@unique([purchaseId, idempotencyKey])
  @@unique([provider, providerRefundId])
  @@index([purchaseId, status])
  @@index([status, createdAt])
  @@map("credit_refund")
  @@schema("opod")
}

model CreditUsage {
  usageLedgerId String       @map("usage_ledger_id") @db.Uuid
  grantLedgerId String       @map("grant_ledger_id") @db.Uuid
  amount        Int
  usageLedger   CreditLedger @relation("UsageLedger", fields: [usageLedgerId], references: [id], onDelete: Cascade)
  grantLedger   CreditLedger @relation("UsageGrant", fields: [grantLedgerId], references: [id], onDelete: Restrict)

  @@id([usageLedgerId, grantLedgerId])
  @@index([grantLedgerId])
  @@map("credit_usage")
  @@schema("opod")
}

model CreditReservation {
  id         String                  @id @default(uuid(7)) @db.Uuid
  userId     String                  @map("user_id") @db.Uuid
  actionType String                  @map("action_type")
  amount     Int
  status     CreditReservationStatus @default(reserved)
  reference  String                  @unique
  expiresAt  DateTime                @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       User                    @relation(fields: [userId], references: [id])

  @@index([userId, status, expiresAt])
  @@map("credit_reservations")
  @@schema("opod")
}

model CreditCheckIn {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  // KST calendar date the user checked in, formatted YYYY-MM-DD.
  checkInDate String   @map("check_in_date")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, checkInDate])
  @@map("credit_check_ins")
  @@schema("opod")
}

model GenerationJob {
  id                String                @id @default(uuid(7)) @db.Uuid
  characterId       String                @map("character_id") @db.Uuid
  mediaType         MediaType             @map("media_type")
  prompt            String
  inputPrompt       String?               @map("input_prompt")
  candidateCount    Int?                  @map("candidate_count")
  status            GenerationJobStatus   @default(queued)
  // 선택된 최종 출력 캐시. 후보 전체는 GenerationJobOutput에 기록된다.
  outputMediaId     String?               @map("output_media_id") @db.Uuid
  provider          String?
  paramsJson        Json?                 @map("params_json")
  // 프로바이더 제출 직후 기록. 재시작/재수용 시 새로 제출하지 않고 결과 폴링으로
  // 이어받는 근거이자 이중 제출·이중 과금 방지 장치.
  providerRequestId String?               @map("provider_request_id")
  // 워커 claim 시 설정. 만료된 running 잡은 스윕이 queued로 되돌리거나 failed 처리.
  leaseExpiresAt    DateTime?             @map("lease_expires_at") @db.Timestamptz(6)
  attemptCount      Int                   @default(0) @map("attempt_count")
  // 수동 재생성 계보. 자동 재시도는 같은 행의 attemptCount 증가로 처리한다.
  originJobId       String?               @map("origin_job_id") @db.Uuid
  errorMessage      String?               @map("error_message")
  costUsd           Decimal?              @map("cost_usd") @db.Decimal(10, 4)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  // draft 소속 컷. draft 1 : 컷 N (sortOrder = 캐러셀 순서). 수동 재생성 시
  // 같은 (draftId, sortOrder)로 새 행이 생기며, 집계는 컷별 최신 행 기준.
  draftId           String?               @map("draft_id") @db.Uuid
  sortOrder         Int                   @default(0) @map("sort_order")
  character         Character             @relation(fields: [characterId], references: [id])
  outputMedia       Media?                @relation(fields: [outputMediaId], references: [id])
  originJob         GenerationJob?        @relation("GenerationJobRetries", fields: [originJobId], references: [id])
  retries           GenerationJob[]       @relation("GenerationJobRetries")
  outputs           GenerationJobOutput[]
  llmLogs           LlmLog[]
  draft             PostDraft?            @relation(fields: [draftId], references: [id])

  @@index([status, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([draftId])
  @@map("generation_jobs")
  @@schema("opod")
}

// 포스트 초안 — 기획~게시의 단위이자 워커의 기획/게시 큐.
model PostDraft {
  id               String             @id @default(uuid(7)) @db.Uuid
  characterId      String             @map("character_id") @db.Uuid
  locationId       String?            @map("location_id") @db.Uuid
  draftType        PostDraftType      @default(post) @map("draft_type")
  contentType      PostContentType    @default(feed) @map("content_type")
  caption          String             @default("")
  hashtags         String[]           @default([])
  // LLM 기획 원본 (shots 포함). 수동 생성 시 scene 힌트도 여기 담는다.
  conceptJson      Json?              @map("concept_json")
  status           PostDraftStatus    @default(planned)
  errorMessage     String?            @map("error_message")
  // 워커 claim lease. 만료된 generating 잡은 스윕이 회수한다.
  leaseExpiresAt   DateTime?          @map("lease_expires_at") @db.Timestamptz(6)
  attemptCount     Int                @default(0) @map("attempt_count")
  // 게시 예정 시각 (KST 정책으로 산출, UTC 저장). null이면 승인 즉시 게시.
  scheduledAt      DateTime?          @map("scheduled_at") @db.Timestamptz(6)
  publishedPostId  String?            @map("published_post_id") @db.Uuid
  publishedStoryId String?            @map("published_story_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  character        Character          @relation(fields: [characterId], references: [id])
  location         CharacterLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  publishedPost    Post?              @relation(fields: [publishedPostId], references: [id])
  publishedStory   Story?             @relation(fields: [publishedStoryId], references: [id])
  jobs             GenerationJob[]

  @@index([status, scheduledAt])
  @@index([status, leaseExpiresAt])
  @@index([characterId, createdAt])
  @@index([locationId, createdAt])
  @@map("post_drafts")
  @@schema("opod")
}

// 캐릭터별 자동 포스팅 정책. 스케줄러가 이 정책으로 planned draft를 생성한다.
model CharacterPostingPolicy {
  id            String    @id @default(uuid(7)) @db.Uuid
  characterId   String    @unique @map("character_id") @db.Uuid
  enabled       Boolean   @default(false)
  // 주당 게시 횟수. 게시 간격 = 7/weeklyCadence일.
  weeklyCadence Int       @default(3) @map("weekly_cadence")
  // 게시 시간창 (KST 시, 0-23). 창 내 랜덤 지터로 scheduledAt을 잡는다.
  hourStartKst  Int       @default(18) @map("hour_start_kst")
  hourEndKst    Int       @default(22) @map("hour_end_kst")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_posting_policies")
  @@schema("opod")
}

// best-of-N 후보 저장. 잡 1개 = 컷 1개, 후보 이미지들이 candidateIndex로 매달린다.
model GenerationJobOutput {
  id             String        @id @default(uuid(7)) @db.Uuid
  jobId          String        @map("job_id") @db.Uuid
  mediaId        String        @map("media_id") @db.Uuid
  candidateIndex Int           @map("candidate_index")
  selected       Boolean       @default(false)
  filterPreset   String?       @map("filter_preset")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  job            GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  media          Media         @relation(fields: [mediaId], references: [id])

  @@unique([jobId, candidateIndex])
  @@index([mediaId])
  @@map("generation_job_outputs")
  @@schema("opod")
}

// 캐릭터의 시각적 정체성. 페르소나(말투/성격)와 분리된 외모/화풍 프롬프트와
// 레퍼런스 이미지 세트. 미디어 생성 프롬프트 컴파일 시 주입된다.
model CharacterVisualProfile {
  id               String                            @id @default(uuid(7)) @db.Uuid
  characterId      String                            @unique @map("character_id") @db.Uuid
  appearancePrompt String                            @default("") @map("appearance_prompt")
  stylePrompt      String                            @default("") @map("style_prompt")
  negativePrompt   String                            @default("") @map("negative_prompt")
  providerConfig   Json?                             @map("provider_config")
  createdAt        DateTime                          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                          @updatedAt @map("updated_at") @db.Timestamptz(6)
  character        Character                         @relation(fields: [characterId], references: [id], onDelete: Cascade)
  referenceMedia   CharacterVisualProfileReference[]

  @@map("character_visual_profiles")
  @@schema("opod")
}

model CharacterVisualProfileReference {
  profileId   String                 @map("profile_id") @db.Uuid
  mediaId     String                 @map("media_id") @db.Uuid
  sortOrder   Int                    @default(0) @map("sort_order")
  // 비전 LLM이 생성한 이미지 서술(장면·구도·의상·조명) — 기획 LLM이 샷별로
  // 관련 레퍼런스를 선별하는 데 쓴다. 빈 값은 캡셔닝 전(백필 대상).
  description String                 @default("")
  profile     CharacterVisualProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  media       Media                  @relation(fields: [mediaId], references: [id])

  @@id([profileId, mediaId])
  @@map("character_visual_profile_references")
  @@schema("opod")
}

// 캐릭터가 게시물에서 반복 사용하는 장소. characterId가 null이면 모든
// 캐릭터가 사용할 수 있는 범용 장소이고, 값이 있으면 해당 캐릭터 전용이다.
model CharacterLocation {
  id             String                       @id @default(uuid(7)) @db.Uuid
  characterId    String?                      @map("character_id") @db.Uuid
  locationKey    String                       @map("location_key")
  displayName    String                       @map("display_name")
  description    String
  visualPrompt   String                       @map("visual_prompt")
  negativePrompt String                       @default("") @map("negative_prompt")
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?                    @map("deleted_at") @db.Timestamptz(6)
  character      Character?                   @relation(fields: [characterId], references: [id], onDelete: Cascade)
